# =============================================================================
# DocMind configuration. Copy to .env and fill in real keys. NEVER commit .env.
# Every model ID, key, base URL and provider is read from here via
# backend/app/core/config.py. Placeholders only in this file.
#
# Model IDs below were checked against the OpenRouter public catalogue on
# 2026-10-03. Provider catalogues change quickly: re-check before a demo
# (`make doctor` prints the configured chain).
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime profile
# -----------------------------------------------------------------------------
APP_ENV=dev
LOG_LEVEL=INFO
DEV_LITE_MODE=true
# cpu_8gb = no GPU, 8 GB RAM: hosted LLM/VLM/embeddings/reranker; only OCR and
# SigLIP2-base run locally. Other values: cpu_16gb, gpu.
HARDWARE_PROFILE=cpu_8gb

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Auth (generate with: python -c "import secrets;print(secrets.token_urlsafe(48))")
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# Data layer (docker-compose.yml runs these four services)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docmind
POSTGRES_USER=docmind
POSTGRES_PASSWORD=change-me-postgres

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TEXT_COLLECTION=docmind_text
QDRANT_IMAGE_COLLECTION=docmind_images

REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=docmind
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=docmind
MINIO_SECURE=false

HEALTH_TIMEOUT_SECONDS=3

# =============================================================================
# LLM fallback chain
# =============================================================================
# Order here = fallback order. The agent reads LLM_<n>_* for each n in the list.
LLM_CHAIN=1,2,3,4,5

# DEFAULT SETUP: all five models through OpenRouter (one key, OpenAI-compatible)
# Get a key at https://openrouter.ai/keys and set a spending limit on it.

# 1) Primary: GPT-OSS 120B
LLM_1_LABEL=gpt-oss-120b
LLM_1_BASE_URL=https://openrouter.ai/api/v1
LLM_1_API_KEY=your-openrouter-key
LLM_1_MODEL=openai/gpt-oss-120b

# 2) Fallback 1: Nemotron 3 Nano 30B-A3B
#    (":free" variant exists, but it is rate-limited; use it only for dev)
LLM_2_LABEL=nemotron-3-nano-30b-a3b
LLM_2_BASE_URL=https://openrouter.ai/api/v1
LLM_2_API_KEY=your-openrouter-key
LLM_2_MODEL=nvidia/nemotron-3-nano-30b-a3b

# 3) Fallback 2: DeepSeek V4 Flash (GA release 0731)
#    If this slug is not found, try the earlier preview slug:
#    deepseek/deepseek-v4-flash
LLM_3_LABEL=deepseek-v4-flash
LLM_3_BASE_URL=https://openrouter.ai/api/v1
LLM_3_API_KEY=your-openrouter-key
LLM_3_MODEL=deepseek/deepseek-v4-flash-0731

# 4) Fallback 3: Qwen 27B (the plan says "Qwen 27B"; newest generation chosen)
#    Older generation, if you prefer: qwen/qwen3.5-27b
LLM_4_LABEL=qwen3.8-27b
LLM_4_BASE_URL=https://openrouter.ai/api/v1
LLM_4_API_KEY=your-openrouter-key
LLM_4_MODEL=qwen/qwen3.8-27b

# 5) Final fallback: Llama 3.3 70B
#    NOTE: there is no "Llama 3.3 70B Instant". Groq's llama-3.3-70b-versatile
#    was shut down on 2026-08-16 for free/developer tiers, so use the Instruct
#    model via OpenRouter.
LLM_5_LABEL=llama-3.3-70b-instruct
LLM_5_BASE_URL=https://openrouter.ai/api/v1
LLM_5_API_KEY=your-openrouter-key
LLM_5_MODEL=meta-llama/llama-3.3-70b-instruct

# Fallback behaviour
LLM_TIMEOUT_SECONDS=60
LLM_RETRIES_PER_MODEL=1
# Skip a model that just failed for this many seconds before trying it again
LLM_COOLDOWN_SECONDS=60
# Move to the next model on: timeout, HTTP 429, HTTP 5xx, or structured output
# that is still invalid after one repair attempt. NOT because an answer "seems
# weak" (that is the Verifier agent's job).
LLM_FALLBACK_ON=timeout,429,5xx,invalid_output
# Reasoning models need room to think; keep this generous
LLM_MAX_OUTPUT_TOKENS=4096

# OPTIONAL: reduce single-provider risk (one OpenRouter outage would otherwise
# take down all five entries). To put the primary on Groq instead, replace the
# LLM_1_* values with:
#   LLM_1_BASE_URL=https://api.groq.com/openai/v1
#   LLM_1_API_KEY=your-groq-key
#   LLM_1_MODEL=openai/gpt-oss-120b
# To call DeepSeek directly for entry 3 (check https://api-docs.deepseek.com
# for the current base URL), use model name: deepseek-flash
# To call Qwen on Groq for entry 4, use: qwen/qwen3.8-27b

# =============================================================================
# Vision model (NOT part of the LLM fallback chain)
# =============================================================================
# off | triaged | all   (triaged = only diagrams, labelled renders, UI screenshots)
VLM_MODE=triaged
# api = hosted OpenAI-compatible chat endpoint with image input.
VLM_BACKEND=api
# Hosted Qwen2.5-VL (same family as the plan; local Qwen2.5-VL is out of scope
# on cpu_8gb). Cheaper alternative: qwen/qwen3-vl-32b-instruct
VLM_MODEL=qwen/qwen2.5-vl-72b-instruct
VLM_BASE_URL=https://openrouter.ai/api/v1
VLM_API_KEY=your-openrouter-key
VLM_TIMEOUT_SECONDS=90
VLM_MAX_CALLS_PER_DOCUMENT=40
VLM_MAX_OUTPUT_TOKENS=2048

# =============================================================================
# Text embeddings (BGE-M3, dense 1024-d via OpenAI-compatible /embeddings)
# =============================================================================
# api | local   (local only for tiny tests on cpu_8gb)
EMBED_BACKEND=api
EMBED_MODEL=BAAI/bge-m3
EMBED_BASE_URL=https://api.siliconflow.com/v1
EMBED_API_KEY=your-siliconflow-key
EMBED_DIM=1024
EMBED_BATCH_SIZE=8

# =============================================================================
# Reranker (bge-reranker-v2-m3 via a Jina/Cohere-style POST {base}/rerank)
# =============================================================================
# api | local | off   (off or failing -> fusion order, and the fallback is logged)
RERANK_BACKEND=api
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.com/v1
RERANK_API_KEY=your-siliconflow-key
RERANK_CANDIDATES=20
RERANK_TOP_N=6

# =============================================================================
# Image embeddings (SigLIP2, local CPU, triaged figure crops only)
# =============================================================================
IMAGE_EMBED_BACKEND=local
IMAGE_EMBED_MODEL=google/siglip2-base-patch16-224
IMAGE_EMBED_BATCH_SIZE=4
IMAGE_EMBED_IDLE_UNLOAD_SECONDS=120
# descriptions_only | siglip2 | both
IMAGE_RETRIEVAL_MODE=both

# =============================================================================
# OCR (PaddleOCR-family models on ONNX Runtime, CPU)
# =============================================================================
OCR_BACKEND=rapidocr_onnx
OCR_LANG=en

# =============================================================================
# Ingestion and resource limits
# =============================================================================
MAX_CONCURRENT_INGESTION=1
CACHE_DIR=.cache/docmind
MAX_UPLOAD_MB=50
# Page routing thresholds (A2.1 / A2.7)
PROFILE_MIN_TEXT_CHARS=200
COMPLEX_PAGE_IMAGE_RATIO=0.6
# make doctor warns if estimated pipeline peak exceeds free RAM minus this
DOCTOR_RAM_HEADROOM_MB=1024
